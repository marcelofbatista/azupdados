# Copie para .env e ajuste. O .env nunca vai para o Git.
POSTGRES_DB=azupdados
POSTGRES_USER=azupdados
POSTGRES_PASSWORD=troque-esta-senha
# use 127.0.0.1, não "localhost": localhost pode resolver para IPv6 (::1) e o container só escuta em IPv4
POSTGRES_HOST=127.0.0.1
# porta do host; use outra se 5432 já estiver ocupada por outro Postgres no servidor
POSTGRES_PORT=5433
